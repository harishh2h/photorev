# Backend API URL — for local development only.
# In Docker, use the API_URL env var on the web container instead (no rebuild needed).
# Leave unset to auto-derive from window.location.hostname:3000 at runtime.
# VITE_API_URL=http://localhost:3000

# Vite dev server binds 0.0.0.0:5173 (see vite.config.js) — open from phone:
# http://<your-mac-ip>:5173  (same Wi‑Fi). Backend must run: npm run backend:dev

# Project page performance (default: enabled when unset)
# VITE_PHOTO_LAZY_LOAD=true
# VITE_PHOTO_SIGNED_URLS=true
# VITE_PHOTO_VIRTUAL_GRID=true
