# Server
PORT=3000
HOST=0.0.0.0
# Photo + export files (relative to packages/backend when running locally)
STORAGE_ROOT=./storage

# Database (PostgreSQL)
DB_CLIENT=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=photorev

# Auth: first-run setup and public registration
# Set to "true" to allow anyone to self-register. Default is false (invite-only).
AUTH_PUBLIC_REGISTRATION=false

# Auth / signed photo URLs
# REQUIRED: set a strong, unique secret (>= 16 chars). The server refuses to start if this is
# missing, too short, or left at a known placeholder. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-in-production
# CONTENT_SIGNING_SECRET=optional-dedicated-secret
# CONTENT_SIGNING_ENABLED=true

# Comma-separated allowlist of browser origins, e.g. https://app.example.com,https://admin.example.com
# Leave unset for local development (all origins reflected).
# CORS_ORIGIN=

# Vite preview allowed hosts (Docker web service). Comma-separated, e.g. photorev.yourserver.in
# Leave unset to allow all hosts (safe behind a reverse proxy).
# VITE_ALLOWED_HOSTS=

# Set to "production" in real deployments. This disables the test auth bypass guard,
# the /docs Swagger UI, and other dev-only affordances.
# NODE_ENV=production

# Elastic APM (optional — needs SERVER_URL + API_KEY or SECRET_TOKEN)
# Elastic Cloud: use an APM API key (secret token not required). Stack Management → API keys.
# ELASTIC_APM_ACTIVE=true
# ELASTIC_APM_SERVICE_NAME=photorev-api
# ELASTIC_APM_SERVER_URL=https://your-deployment.apm.region.gcp.elastic.cloud:443
# ELASTIC_APM_API_KEY=<base64 id:api_key from Elastic Cloud>
# ELASTIC_APM_SECRET_TOKEN=   # optional; omit when using API key
# ELASTIC_APM_ENVIRONMENT=development
