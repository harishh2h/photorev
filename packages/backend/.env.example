# Server
PORT=3000
HOST=0.0.0.0
# Photo + export files (relative to packages/backend when running locally)
STORAGE_ROOT=./storage

# Database (PostgreSQL)
DB_CLIENT=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=photorev

# Auth / signed photo URLs
# REQUIRED: set a strong, unique secret (>= 16 chars). The server refuses to start if this is
# missing, too short, or left at a known placeholder. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-in-production
# CONTENT_SIGNING_SECRET=optional-dedicated-secret
# CONTENT_SIGNING_ENABLED=true

# Comma-separated allowlist of browser origins, e.g. https://app.example.com,https://admin.example.com
# Leave unset for local development (all origins reflected).
# CORS_ORIGIN=

# Set to "production" in real deployments. This disables the test auth bypass guard,
# the /docs Swagger UI, and other dev-only affordances.
# NODE_ENV=production
