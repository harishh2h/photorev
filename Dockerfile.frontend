# PhotoRev web — build and serve with Vite preview
FROM node:22-bookworm-slim AS build

RUN corepack enable && corepack prepare pnpm@10.30.2 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/frontend/package.json ./packages/frontend/

RUN pnpm install --frozen-lockfile --filter @photorev/frontend...

COPY packages/frontend ./packages/frontend

ARG VITE_API_URL=http://localhost:3000
ENV VITE_API_URL=${VITE_API_URL}

WORKDIR /app/packages/frontend
RUN pnpm run build

FROM node:22-bookworm-slim AS runner

RUN corepack enable && corepack prepare pnpm@10.30.2 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/frontend/package.json ./packages/frontend/

RUN pnpm install --frozen-lockfile --filter @photorev/frontend...

COPY --from=build /app/packages/frontend/dist ./packages/frontend/dist
COPY packages/frontend/vite.config.js ./packages/frontend/

WORKDIR /app/packages/frontend

EXPOSE 5173

CMD ["pnpm", "exec", "vite", "preview", "--host", "0.0.0.0", "--port", "5173"]
